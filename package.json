{
  "name": "wysidown-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.13.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:fast": "vitest run --project core --project editor",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "e2e": "pnpm -r --workspace-concurrency=1 run e2e",
    "package": "pnpm -r --workspace-concurrency=1 run package",
    "gate": "node scripts/gate.mjs",
    "check": "node scripts/gate.mjs --no-e2e",
    "local": "node scripts/local.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
